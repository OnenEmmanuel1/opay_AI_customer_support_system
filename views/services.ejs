<%- include('partials/header') %>
<%- include('partials/navbar') %>

<section class="py-5 mt-5 bg-light">
    <div class="container py-5 text-center">
        <h1 class="display-4 fw-bold text-dark">Banking Services Simulation</h1>
        <p class="lead text-muted">Test the capabilities of our AI across different banking scenarios.</p>
    </div>
</section>

<section class="py-5 my-4">
    <div class="container">
        <div class="row g-4">
            <!-- Service 1 -->
            <div class="col-md-4">
                <div class="card border-0 shadow-sm h-100 rounded-4">
                    <div class="card-body p-4 text-center">
                        <div class="bg-opay-light text-opay-green rounded-circle d-inline-flex justify-content-center align-items-center mb-4" style="width: 70px; height: 70px;">
                            <i class="fa-solid fa-arrow-right-arrow-left fs-3"></i>
                        </div>
                        <h4 class="fw-bold">Transfer Status</h4>
                        <p class="text-muted">Ask the AI to check the status of a specific transaction reference. It simulates querying the database to determine if it was successful, reversed, or pending.</p>
                    </div>
                </div>
            </div>
            
            <!-- Service 2 -->
            <div class="col-md-4">
                <div class="card border-0 shadow-sm h-100 rounded-4">
                    <div class="card-body p-4 text-center">
                        <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-inline-flex justify-content-center align-items-center mb-4" style="width: 70px; height: 70px;">
                            <i class="fa-solid fa-triangle-exclamation fs-3"></i>
                        </div>
                        <h4 class="fw-bold">Dispute Resolution</h4>
                        <p class="text-muted">Report an unauthorized debit. The AI will instantly lock the simulated account and escalate an urgent ticket to the admin dashboard.</p>
                    </div>
                </div>
            </div>
            
            <!-- Service 3 -->
            <div class="col-md-4">
                <div class="card border-0 shadow-sm h-100 rounded-4">
                    <div class="card-body p-4 text-center">
                        <div class="bg-warning bg-opacity-10 text-warning rounded-circle d-inline-flex justify-content-center align-items-center mb-4" style="width: 70px; height: 70px;">
                            <i class="fa-solid fa-id-card fs-3"></i>
                        </div>
                        <h4 class="fw-bold">KYC Upgrades</h4>
                        <p class="text-muted">Users can inquire about upgrading their account tiers. The AI guides them on document requirements based on current regulatory standards.</p>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="text-center mt-5">
            <a href="/auth/register" class="btn btn-opay rounded-pill px-5 py-3 fs-5">Experience it Now</a>
        </div>
    </div>
</section>

<%- include('partials/footer') %>
