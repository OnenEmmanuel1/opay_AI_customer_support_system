<%- include('../partials/header') %>
<%- include('../partials/admin-nav') %>

<div class="container-fluid">
    <div class="row">
        <!-- Sidebar Navigation -->
        <%- include('../partials/admin-sidebar', { active: 'tickets' }) %>

        <!-- Ticket Queue main content -->
        <main class="col-md-9 col-lg-10 aiop-dashboard-content">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="fw-bold m-0"><i class="fa-solid fa-ticket me-2 text-muted"></i> Support Ticket Queue</h2>
            </div>

            <!-- Filters Card -->
            <div class="aiop-card">
                <form method="GET" action="/admin/tickets" class="row g-2">
                    <div class="col-md-3">
                        <label for="status" class="form-label fw-bold small text-muted">Status</label>
                        <select name="status" id="status" class="aiop-input">
                            <option value="">-- All Statuses --</option>
                            <option value="open" <%= filters.status === 'open' ? 'selected' : '' %>>Open</option>
                            <option value="in_progress" <%= filters.status === 'in_progress' ? 'selected' : '' %>>In Progress</option>
                            <option value="resolved" <%= filters.status === 'resolved' ? 'selected' : '' %>>Resolved</option>
                            <option value="closed" <%= filters.status === 'closed' ? 'selected' : '' %>>Closed</option>
                        </select>
                    </div>

                    <div class="col-md-3">
                        <label for="category" class="form-label fw-bold small text-muted">Category</label>
                        <select name="category" id="category" class="aiop-input">
                            <option value="">-- All Categories --</option>
                            <option value="failed_transaction" <%= filters.category === 'failed_transaction' ? 'selected' : '' %>>Failed Transaction</option>
                            <option value="kyc_issue" <%= filters.category === 'kyc_issue' ? 'selected' : '' %>>KYC Issue</option>
                            <option value="account_restriction" <%= filters.category === 'account_restriction' ? 'selected' : '' %>>Account Restriction</option>
                            <option value="card_issue" <%= filters.category === 'card_issue' ? 'selected' : '' %>>Card Issue</option>
                            <option value="other" <%= filters.category === 'other' ? 'selected' : '' %>>Other</option>
                        </select>
                    </div>

                    <div class="col-md-3">
                        <label for="priority" class="form-label fw-bold small text-muted">Priority</label>
                        <select name="priority" id="priority" class="aiop-input">
                            <option value="">-- All Priorities --</option>
                            <option value="low" <%= filters.priority === 'low' ? 'selected' : '' %>>Low</option>
                            <option value="medium" <%= filters.priority === 'medium' ? 'selected' : '' %>>Medium</option>
                            <option value="high" <%= filters.priority === 'high' ? 'selected' : '' %>>High</option>
                            <option value="urgent" <%= filters.priority === 'urgent' ? 'selected' : '' %>>Urgent</option>
                        </select>
                    </div>

                    <div class="col-md-2">
                        <label for="filter" class="form-label fw-bold small text-muted">Assignment</label>
                        <select name="filter" id="filter" class="aiop-input">
                            <option value="" <%= !filters.filter ? 'selected' : '' %>>All Tickets</option>
                            <option value="me" <%= filters.filter === 'me' ? 'selected' : '' %>>Assigned to Me</option>
                            <option value="unassigned" <%= filters.filter === 'unassigned' ? 'selected' : '' %>>Unassigned</option>
                        </select>
                    </div>

                    <div class="col-md-1 d-flex align-items-end">
                        <button type="submit" class="aiop-btn aiop-btn-primary w-100 p-2 text-white">
                            <i class="fa-solid fa-filter"></i>
                        </button>
                    </div>
                </form>
            </div>

            <!-- Queue List Table -->
            <div class="aiop-card">
                <div class="table-responsive">
                    <table class="aiop-console-table">
                        <thead>
                            <tr>
                                <th>Ticket ID</th>
                                <th>Customer Details</th>
                                <th>Category</th>
                                <th>Priority</th>
                                <th>Status</th>
                                <th>Assigned Agent</th>
                                <th>Escalated Date</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (tickets && tickets.length > 0) { %>
                                <% tickets.forEach(t => { %>
                                    <tr>
                                        <td>#<%= t.id %></td>
                                        <td>
                                            <strong class="d-block text-dark"><%= t.customer_name %></strong>
                                            <small class="text-muted"><%= t.customer_email %></small>
                                        </td>
                                        <td class="text-capitalize"><%= t.category.replace('_', ' ') %></td>
                                        <td>
                                            <span class="aiop-badge <%= t.priority === 'urgent' || t.priority === 'high' ? 'aiop-badge-danger' : (t.priority === 'medium' ? 'aiop-badge-warning' : 'aiop-badge-info') %>">
                                                <%= t.priority %>
                                            </span>
                                        </td>
                                        <td>
                                            <span class="aiop-badge <%= t.status === 'resolved' || t.status === 'closed' ? 'aiop-badge-success' : 'aiop-badge-warning' %>">
                                                <%= t.status %>
                                            </span>
                                        </td>
                                        <td>
                                            <select class="aiop-input py-1 reassign-agent-select" data-ticket-id="<%= t.id %>" style="font-size: 0.85rem; width: auto; display: inline-block;">
                                                <option value="">-- Unassigned --</option>
                                                <% agents.forEach(a => { %>
                                                    <option value="<%= a.id %>" <%= t.assigned_agent_id === a.id ? 'selected' : '' %>><%= a.name %></option>
                                                <% }) %>
                                            </select>
                                        </td>
                                        <td><%= new Date(t.created_at).toLocaleString() %></td>
                                        <td>
                                            <a href="/admin/ticket/<%= t.id %>" class="aiop-btn aiop-btn-primary btn-sm text-white text-decoration-none">
                                                <i class="fa-solid fa-comments me-1"></i> Open Console
                                            </a>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="8" class="text-muted text-center py-4">No support tickets match the filter criteria.</td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </main>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
    // Reassign Agent AJAX
    const reassignSelects = document.querySelectorAll('.reassign-agent-select');
    reassignSelects.forEach(select => {
        select.addEventListener('change', async (e) => {
            const ticketId = select.getAttribute('data-ticket-id');
            const agentId = select.value;

            if (!ticketId || !agentId) return;

            try {
                const response = await fetch('/api/tickets/reassign', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ ticketId, agentId })
                });

                const result = await response.json();
                if (result.success) {
                    alert(result.message);
                    window.location.reload();
                } else {
                    alert(result.error || 'Failed to reassign agent.');
                }
            } catch (error) {
                console.error('Reassign agent error:', error);
                alert('Connection error reassigning agent.');
            }
        });
    });
});
</script>

<%- include('../partials/footer') %>
