<%- include('partials/header') %>
<%- include('partials/navbar') %>

<!-- Hero Section -->
<section class="py-5" style="background-color: var(--aiop-slate-100);">
    <div class="container py-5">
        <div class="row align-items-center">
            <div class="col-lg-6 mb-5 mb-lg-0">
                <div class="badge bg-success mb-3 p-2 text-uppercase" style="letter-spacing: 0.05em; font-size: 0.75rem;">
                    <i class="fa-solid fa-robot me-1"></i> NLP-Powered Support
                </div>
                <h1 class="display-4 fw-bold mb-3" style="color: var(--aiop-dark); line-height: 1.2;">
                    Banking Support,<br>Reimagined with <span style="color: var(--aiop-green);">AI</span>.
                </h1>
                <p class="lead text-muted mb-4">
                    Get instant balance checking, simulated transaction tracing, and ticket escalations 24/7 with our customer service chatbot.
                </p>
                
                <div class="d-flex flex-wrap gap-3">
                    <% if (user) { %>
                        <% if (user.role === 'admin' || user.role === 'agent') { %>
                            <a href="/admin/dashboard" class="aiop-btn aiop-btn-primary text-white text-decoration-none py-3 px-4">
                                <i class="fa-solid fa-gauge me-2"></i> Go to Admin Console
                            </a>
                        <% } else { %>
                            <a href="/customer/dashboard" class="aiop-btn aiop-btn-primary text-white text-decoration-none py-3 px-4">
                                <i class="fa-solid fa-gauge me-2"></i> Go to My Dashboard
                            </a>
                            <a href="/customer/chat" class="aiop-btn aiop-btn-outline text-decoration-none py-3 px-4">
                                <i class="fa-solid fa-comments me-2"></i> Live Chat Now
                            </a>
                        <% } %>
                    <% } else { %>
                        <a href="/auth/register" class="aiop-btn aiop-btn-primary text-white text-decoration-none py-3 px-4">
                            Open Free Account
                        </a>
                        <a href="/auth/login" class="aiop-btn aiop-btn-outline text-decoration-none py-3 px-4">
                            Sign In to Support
                        </a>
                    <% } %>
                </div>
            </div>
            
            <!-- Simulated App Demo Panel -->
            <div class="col-lg-6">
                <div class="aiop-card">
                    <div class="aiop-card-header bg-dark text-white p-3 d-flex align-items-center" style="border-radius: var(--aiop-radius) var(--aiop-radius) 0 0;">
                        <div class="aiop-logo-icon me-2" style="background-color: var(--aiop-green);">
                            <i class="fa-solid fa-robot"></i>
                        </div>
                        <div class="text-start">
                            <h6 class="mb-0 fw-bold text-white">OPay AI Assistant</h6>
                            <small class="text-success small">Always Online</small>
                        </div>
                    </div>
                    
                    <div class="aiop-chat-container" style="height: 380px;">
                        <div class="aiop-chat-body" id="demoChatBody">
                            <div class="d-flex mb-3 justify-content-start">
                                <div class="aiop-chat-bubble aiop-chat-bubble-bot">
                                    <p class="mb-0">Hello! Welcome to OPay Support. How can I help you today? 👋</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Core Features Grid -->
<section class="py-5" style="background-color: var(--aiop-white); border-top: 1px solid var(--aiop-slate-200);">
    <div class="container py-4">
        <div class="text-center mb-5">
            <h6 class="text-uppercase fw-bold text-success" style="letter-spacing: 0.05em; font-size: 0.8rem;">Feature Highlights</h6>
            <h2 class="fw-bold display-6">Smarter Support, Better Security</h2>
        </div>

        <div class="row g-4">
            <div class="col-md-4">
                <div class="aiop-card text-center h-100">
                    <div class="d-inline-flex align-items-center justify-content-center text-white mb-3" style="width: 50px; height: 50px; background-color: var(--aiop-green); border-radius: var(--aiop-radius); font-size: 1.25rem;">
                        <i class="fa-solid fa-money-bill-transfer"></i>
                    </div>
                    <h4 class="fw-bold mb-2">Simulated Bank Lookup</h4>
                    <p class="text-muted small mb-0">Ask the chatbot about transaction statuses or wallet balances. The NLP system automatically queries our simulated database logs.</p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="aiop-card text-center h-100">
                    <div class="d-inline-flex align-items-center justify-content-center text-white mb-3" style="width: 50px; height: 50px; background-color: var(--aiop-primary); border-radius: var(--aiop-radius); font-size: 1.25rem;">
                        <i class="fa-solid fa-ticket"></i>
                    </div>
                    <h4 class="fw-bold mb-2">Escalation Routing</h4>
                    <p class="text-muted small mb-0">If the chatbot cannot understand or resolve the issue, it automatically escalated with full chat log transcripts to available support agents.</p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="aiop-card text-center h-100">
                    <div class="d-inline-flex align-items-center justify-content-center text-white mb-3" style="width: 50px; height: 50px; background-color: var(--aiop-danger); border-radius: var(--aiop-radius); font-size: 1.25rem;">
                        <i class="fa-solid fa-shield-halved"></i>
                    </div>
                    <h4 class="fw-bold mb-2">Security Verification</h4>
                    <p class="text-muted small mb-0">Check KYC tier states and simulated account freezes directly. Staff can update customer restriction status in real time.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
document.addEventListener('DOMContentLoaded', () => {
    const demoChatBody = document.getElementById('demoChatBody');
    if (demoChatBody) {
        const demoSequence = [
            { type: 'user', text: 'why is my transfer failed?', delay: 2000 },
            { type: 'bot', text: 'I am sorry to hear that. Please provide the transaction reference number (e.g. TXN1000000002).', delay: 4000 },
            { type: 'user', text: 'It is TXN1000000002', delay: 6500 },
            { type: 'bot', text: '[Simulated Check] I found transaction TXN1000000002. It was a payment of ₦20,000.00 and the status is FAILED. It has been queued for reversal.', delay: 9000 }
        ];

        demoSequence.forEach(msg => {
            setTimeout(() => {
                const wrapper = document.createElement('div');
                wrapper.className = `d-flex mb-3 ${msg.type === 'user' ? 'justify-content-end' : 'justify-content-start'}`;
                
                const bubble = document.createElement('div');
                bubble.className = `aiop-chat-bubble aiop-chat-bubble-${msg.type}`;
                
                const p = document.createElement('p');
                p.className = 'mb-0';
                p.textContent = msg.text;
                
                bubble.appendChild(p);
                wrapper.appendChild(bubble);
                demoChatBody.appendChild(wrapper);
                demoChatBody.scrollTop = demoChatBody.scrollHeight;
            }, msg.delay);
        });
    }
});
</script>

<%- include('partials/chat-widget') %>
<%- include('partials/footer') %>
